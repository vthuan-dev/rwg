# ===== RWG Backend - biến môi trường CHO DOCKER COMPOSE (interpolation) =====
# Copy file này thành .env và đổi các giá trị nhạy cảm TRƯỚC khi chạy docker compose.
# LƯU Ý: file này CHỈ là mẫu; KHÔNG commit file .env thật vào git.
# Biến CHỈ của app (DB_URL/DB_USER/JWT_SECRET/REDIS_URL...) nằm ở .env.app
# (copy từ .env.app.example) — app KHÔNG nhận file này, nên MYSQL_ROOT_PASSWORD
# không bao giờ lọt vào container app.

# --- MySQL 8.4 ---
# Mật khẩu root MySQL trong container (bắt buộc, không có default).
MYSQL_ROOT_PASSWORD=change-me-mysql-root
# Database khởi tạo + dùng cho app.
MYSQL_DB=rwg
MYSQL_PORT=3306
# Mật khẩu của user MySQL RIÊNG cho app (rwg_app) — init script
# docker/mysql-init/01-create-app-user.sh tạo user này ở lần khởi tạo đầu.
# PHẢI trùng DB_PASSWORD trong .env.app.
DB_PASSWORD=change-me-app-user

# --- Redis ---
# Redis KHÔNG publish port ra host (chỉ internal network) + requirepass.
# PHẢI trùng REDIS_PASSWORD trong .env.app.
REDIS_PASSWORD=change-me-redis

# --- App ---
APP_PORT=8080
